# Application
APP_ENV=development
ADMIN_TOKEN=replace-with-a-long-random-token

# Model provider: ollama, runpod (Serverless), runpod_pod, or another OpenAI-compatible endpoint.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3-vl:8b
LLM_API_KEY=

# Local Ollama with Qwen3-VL. In Docker the name ollama resolves to the local
# service; use http://host.docker.internal:11434/v1 when the API is outside Docker.
OLLAMA_BASE_URL=http://ollama:11434/v1

# Runpod OpenAI-compatible endpoint with Qwen3-VL. Activate with LLM_PROVIDER=runpod.
# Set LLM_BASE_URL directly only when using another OpenAI-compatible service.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# A standard Runpod Pod is not a Serverless endpoint. Start an OpenAI-compatible
# model server (for example vLLM) in the Pod and expose its HTTP port. Configure
# LLM_PROVIDER=runpod_pod and fill these fields. LLM_API_KEY is the optional key
# configured in that model server, not the Runpod management API key.
RUNPOD_POD_ID=
RUNPOD_POD_PORT=

LLM_BASE_URL=

# Corporate API. The published documentation requires X-API-KEY.
CORPORATE_API_BASE_URL=http://host.docker.internal:90
CORPORATE_API_KEY=
CORPORATE_API_TIMEOUT_SECONDS=15
CORPORATE_API_DISCONNECTIONS_PATH=/api/disconnection/disconnections
CORPORATE_API_TECHNICAL_CONDITION_PATH=/api/technical_condition/save

# These operations are not in the available public documentation. Leave blank
# until the corporate-system team provides the authoritative routes and schema.
CORPORATE_API_SUBSCRIBER_LOOKUP_PATH=
CORPORATE_API_CAPACITY_PATH=
CORPORATE_API_COMPLAINT_PATH=

# Optional fields required by the technical-condition service in your installation.
TECHNICAL_CONDITION_STATUS_ID=
TECHNICAL_CONDITION_OBJECT_ID=

# Milvus container address. Docker Compose overrides this for the API container.
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=tatek_knowledge
